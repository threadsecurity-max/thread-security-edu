# ============================================================================
# Core Environment Variables (Template - Fill with your credentials)
# NEVER commit real production credentials or .env to Git
# ============================================================================

DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your_secure_random_nextauth_secret_32_chars"
NEXTAUTH_URL="http://localhost:8080"
NODE_ENV="development"

# Outbound Email Service (Resend)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Thread Security Education <onboarding@resend.dev>"
FACULTY_NOTIFY_EMAIL="faculty@example.com"

# Admin & Mentor Portal Access Keys
ADMIN_PASSKEY="your_secure_admin_passkey_here"
ADMIN_SECRET_KEY="your_secure_admin_secret_key_here"
SECURITY_ADMIN_PASSKEY="your_secure_security_admin_passkey_here"
SECURITY_ADMIN_SECRET_KEY="your_secure_security_admin_secret_key_here"
MENTOR_PASSKEY="your_secure_mentor_passkey_here"
MENTOR_SECRET_KEY="your_secure_mentor_secret_key_here"

# Cloudinary Media Management & CDN
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ============================================================================
# GCP & Integration Services Configuration
# ============================================================================
GCP_PROJECT_ID="your-gcp-project-id"
GCP_CLIENT_EMAIL="your-service-account@your-gcp-project.iam.gserviceaccount.com"
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GCP_SEARCH_CONSOLE_SITE_URL="https://example.com"

# Google Analytics 4 (GA4)
GA4_PROPERTY_ID="123456789"
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# Vertex AI / Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Optional Custom SMTP Settings
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Thread Security Education <your-email@gmail.com>"
